{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framed-assistant.dev/schemas/run-host-context-0.1.json",
  "title": "RunHostContext",
  "type": "object",
  "required": [
    "schema_version",
    "actor_id",
    "scope_key",
    "denied_permissions",
    "page_context"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "actor_id": { "type": "string", "minLength": 1 },
    "scope_key": { "type": "string", "minLength": 1 },
    "denied_permissions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "page_context": { "type": "object" }
  },
  "additionalProperties": false
}
