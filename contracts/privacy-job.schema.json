{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framed-assistant.dev/schemas/privacy-job-0.1.json",
  "title": "PrivacyJob",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "kind",
    "status",
    "scope",
    "preview",
    "results",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "id": { "type": "string" },
    "kind": { "enum": ["export", "deletion"] },
    "status": {
      "enum": [
        "requested",
        "previewing",
        "awaiting_confirmation",
        "running",
        "completed",
        "partial",
        "failed",
        "cancelled",
        "retrying"
      ]
    },
    "scope": { "type": "object" },
    "preview": { "type": "object" },
    "results": { "type": "array", "items": { "type": "object" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
